      "lines": [
        1037,
        1061
      ],
      "behavior": "The original weapon is retained. If mirror=true, an additional copy is made, flipped, and appended. The two mounts share the same named weapon region."
    },
    "flip": {
      "source": "Weapon.java",
      "lines": [
        551,
        557
      ],
      "behavior": "flip() negates x, shootX and baseRotation, and toggles flipSprite. The mirrored copy needs no second separately painted weapon PNG."
    },
    "recoilDraw": {
      "source": "Weapon.java",
      "lines": [
        218,
        229
      ],
      "behavior": "Weapon.draw computes realRecoil=pow(mount.recoil,recoilPow)*recoil and offsets wx/wy along the weapon's backward direction before drawing the weapon region. A fixed rotate=false weapon still has independent visual recoil."
    },
    "regionDraw": {
      "source": "Weapon.java",
      "line": 259
    },
    "topMeaning": "Weapon.top is documented as whether to draw the weapon outline on top; it must not alone be interpreted as a complete draw-order contract for the whole texture.",
    "coordinateWarning": "x/y/recoil/shootY values below are original Mindustry world units; they are NOT image pixels, texture pivots, or runtime-verified art alignment. All pixel anchors in the repair manifest must be separately labeled as estimated."
